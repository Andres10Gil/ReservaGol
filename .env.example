# Copia este archivo a ".env" y ajusta los valores para tu entorno local.
# El archivo ".env" real NUNCA debe subirse al repositorio (ver .gitignore).

# Base de datos SQL Server
DB_NAME=ReservaGolDB
DB_SA_PASSWORD=CambiaEstaClave123!

# JWT (autenticación)
